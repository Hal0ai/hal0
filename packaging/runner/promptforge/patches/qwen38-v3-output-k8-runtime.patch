+bool load_mtp_output_proxy(PFState & s, const char * path) {
+    const int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        std::fprintf(stderr, "promptforge: cannot open MTP output proxy %s\n", path);
+        return false;
+    }
+
+    struct stat st {};
+    PFOutputK8Header header {};
+    const char expected_magic[8] = {'P', 'F', 'O', 'U', 'K', '8', 'Q', '4'};
+    const bool valid_file = fstat(fd, &st) == 0 &&
+                            uint64_t(st.st_size) == PF_MTP_PROXY_FILE_BYTES &&
+                            pread(fd, &header, sizeof(header), 0) == ssize_t(sizeof(header)) &&
+                            std::memcmp(header.magic, expected_magic, sizeof(expected_magic)) == 0 &&
+                            header.version == 1 &&
+                            header.header_bytes == PF_MTP_PROXY_DATA_OFFSET &&
+                            header.tensor_type == PF_MTP_PROXY_TYPE &&
+                            header.n_embd == PF_MTP_OUTPUT_H &&
+                            header.n_vocab == PF_MTP_OUTPUT_V &&
+                            header.shortlist_k == PF_MTP_OUTPUT_K &&
+                            header.data_offset == PF_MTP_PROXY_DATA_OFFSET &&
+                            header.payload_bytes == PF_MTP_PROXY_BYTES &&
+                            header.file_bytes == PF_MTP_PROXY_FILE_BYTES &&
+                            header.source_data_offset == PF_MTP_PROXY_SOURCE_OFFSET &&
+                            std::memcmp(header.source_sha256, PF_MTP_PROXY_SOURCE_SHA256_BYTES.data(),
+                                        PF_MTP_PROXY_SOURCE_SHA256_BYTES.size()) == 0 &&
+                            std::memcmp(header.payload_sha256, PF_MTP_PROXY_PAYLOAD_SHA256_BYTES.data(),
+                                        PF_MTP_PROXY_PAYLOAD_SHA256_BYTES.size()) == 0;
+    if (!valid_file) {
+        std::fprintf(stderr, "promptforge: MTP output K8 sidecar identity mismatch\n");
+        close(fd);
+        return false;
+    }
+
+    const long page_size_long = sysconf(_SC_PAGESIZE);
+    if (page_size_long <= 0) {
+        std::fprintf(stderr, "promptforge: cannot determine page size for MTP output proxy\n");
+        close(fd);
+        return false;
+    }
+    const uint64_t page_size = uint64_t(page_size_long);
+    const uint64_t map_offset = PF_MTP_PROXY_DATA_OFFSET / page_size * page_size;
+    const uint64_t map_delta = PF_MTP_PROXY_DATA_OFFSET - map_offset;
+    const uint64_t map_bytes = map_delta + PF_MTP_PROXY_BYTES;
+    void * mapping = mmap(nullptr, map_bytes, PROT_READ, MAP_PRIVATE, fd, off_t(map_offset));
+    if (mapping == MAP_FAILED) {
+        std::fprintf(stderr, "promptforge: MTP output proxy mmap failed\n");
+        close(fd);
+        return false;
+    }
+
+    const uint8_t * proxy_host = static_cast<const uint8_t *>(mapping) + map_delta;
+    const bool ok = hip_check(hipMalloc(&s.mtp_output_proxy, PF_MTP_PROXY_BYTES), "hipMalloc(mtp output proxy)") &&
+                    hip_check(hipMemcpy(s.mtp_output_proxy, proxy_host, PF_MTP_PROXY_BYTES, hipMemcpyHostToDevice),
+                              "hipMemcpy(mtp output proxy)");
+    madvise(mapping, map_bytes, MADV_DONTNEED);
+    munmap(mapping, map_bytes);
+    posix_fadvise(fd, off_t(PF_MTP_PROXY_DATA_OFFSET), off_t(PF_MTP_PROXY_BYTES), POSIX_FADV_DONTNEED);
+    close(fd);
+    if (!ok) {
+        return false;
+    }
+
+    std::fprintf(stderr,
+        "{\"record\":\"promptforge_mtp_output_k8_proxy\",\"type\":\"Q4_0_ROCMFP4\","
+        "\"shape\":[%d,%d],\"shortlist_k\":%d,\"file_bytes\":%llu,\"data_offset\":%llu,"
+        "\"tensor_bytes\":%llu,\"source_sha256\":\"%s\",\"payload_sha256\":\"%s\","
+        "\"package_sha256\":\"%s\"}\n",
+        PF_MTP_OUTPUT_H, PF_MTP_OUTPUT_V,
+        PF_MTP_OUTPUT_K,
+        (unsigned long long) PF_MTP_PROXY_FILE_BYTES,
+        (unsigned long long) PF_MTP_PROXY_DATA_OFFSET,
+        (unsigned long long) PF_MTP_PROXY_BYTES,
+        PF_MTP_PROXY_SOURCE_SHA256,
+        PF_MTP_PROXY_PAYLOAD_SHA256,
+        PF_MTP_PROXY_FILE_SHA256);
+    return true;
+}
+
+__global__ void gather_quantized_rows(const uint8_t * src, const int32_t * rows,
+                                      uint8_t * dst, size_t row_bytes, int n_rows) {
+    const size_t i = size_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    const size_t count = size_t(n_rows) * row_bytes;
+    if (i < count) {
+        const int row = int(i / row_bytes);
+        const size_t col = i - size_t(row) * row_bytes;
+        dst[i] = src[size_t(rows[row]) * row_bytes + col];
+    }
+}
+
+__global__ void fill_negative_infinity(float * dst, size_t count) {
+    const size_t i = size_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i < count) {
+        dst[i] = -3.402823466e+38F;
+    }
+}
+
+__global__ void scatter_reranked_logits(float * dst, const int32_t * rows,
+                                        const float * logits, int n_rows) {
+    const int i = int(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i < n_rows) {
+        dst[rows[i]] = logits[i];
+    }
+}
+
+__device__ __forceinline__ bool mtp_output_better(float lhs_value, int32_t lhs_id,
+                                                   float rhs_value, int32_t rhs_id) {
+    return lhs_value > rhs_value || (lhs_value == rhs_value && lhs_id < rhs_id);
+}
+
+__global__ void mtp_output_top8(const float * src, int32_t n, int32_t * dst) {
+    constexpr int n_threads = 256;
+    constexpr int n_items = n_threads * PF_MTP_OUTPUT_K;
+    __shared__ float values[n_items];
+    __shared__ int32_t ids[n_items];
+
+    float local_values[PF_MTP_OUTPUT_K];
+    int32_t local_ids[PF_MTP_OUTPUT_K];
+#pragma unroll
+    for (int k = 0; k < PF_MTP_OUTPUT_K; ++k) {
+        local_values[k] = -3.402823466e+38F;
+        local_ids[k] = INT32_MAX;
+    }
+
+    for (int32_t i = int32_t(threadIdx.x); i < n; i += n_threads) {
+        const float value = src[i];
+        if (!mtp_output_better(value, i, local_values[PF_MTP_OUTPUT_K - 1],
+                               local_ids[PF_MTP_OUTPUT_K - 1])) {
+            continue;
+        }
+        int pos = PF_MTP_OUTPUT_K - 1;
+        while (pos > 0 && mtp_output_better(value, i, local_values[pos - 1], local_ids[pos - 1])) {
+            local_values[pos] = local_values[pos - 1];
+            local_ids[pos] = local_ids[pos - 1];
+            --pos;
+        }
+        local_values[pos] = value;
+        local_ids[pos] = i;
+    }
+
+#pragma unroll
+    for (int k = 0; k < PF_MTP_OUTPUT_K; ++k) {
+        const int out = int(threadIdx.x) * PF_MTP_OUTPUT_K + k;
+        values[out] = local_values[k];
+        ids[out] = local_ids[k];
+    }
+    __syncthreads();
+
+    for (int width = 2; width <= n_items; width <<= 1) {
+        for (int stride = width >> 1; stride > 0; stride >>= 1) {
+            for (int i = int(threadIdx.x); i < n_items; i += n_threads) {
+                const int peer = i ^ stride;
+                if (peer <= i) {
+                    continue;
+                }
+                const bool descending = (i & width) == 0;
+                const bool left_better = mtp_output_better(values[i], ids[i], values[peer], ids[peer]);
+                if ((descending && !left_better) || (!descending && left_better)) {
+                    const float value = values[i];
+                    const int32_t id = ids[i];
+                    values[i] = values[peer];
+                    ids[i] = ids[peer];
+                    values[peer] = value;
+                    ids[peer] = id;
+                }
+            }
+            __syncthreads();
+        }
+    }
+
+    if (threadIdx.x < PF_MTP_OUTPUT_K) {
+        dst[threadIdx.x] = ids[threadIdx.x];
+    }
+}
