+}
+
+bool promptforge_try_mtp_output_k8(ggml_backend_cuda_context * ctx,
+                                   const ggml_tensor * weight, const ggml_tensor * input, ggml_tensor * dst) {
+    PFState & s = state();
+    if (!s.ready || !s.mtp_output_k8_enabled || !ctx || !weight || !input || !dst) {
+        return false;
+    }
+
+    if (std::strcmp(input->name, "mtp_shared_head_norm") != 0) {
+        return false;
+    }
+
+    const bool exact_route = std::strcmp(weight->name, "output.weight") == 0 &&
+                             weight->type == GGML_TYPE_Q8_0_ROCMFPX &&
+                             exact_tensor(weight, GGML_TYPE_Q8_0_ROCMFPX, PF_MTP_OUTPUT_H, PF_MTP_OUTPUT_V) &&
+                             exact_tensor(input, GGML_TYPE_F32, PF_MTP_OUTPUT_H, 1) &&
+                             exact_tensor(dst, GGML_TYPE_F32, PF_MTP_OUTPUT_V, 1);
+    if (!exact_route) {
+        std::fprintf(stderr,
+            "promptforge: MTP output-k8 route identity failed (weight=%s/%s input=%s/%s dst=%s/%s)\n",
+            weight->name, ggml_type_name(weight->type), input->name, ggml_type_name(input->type),
+            dst->name, ggml_type_name(dst->type));
+        std::abort();
+    }
+
+    ggml_tensor proxy_weight = *weight;
+    set_contiguous_2d(proxy_weight, GGML_TYPE_Q4_0_ROCMFP4,
+                      PF_MTP_OUTPUT_H, PF_MTP_OUTPUT_V, s.mtp_output_proxy);
+    ggml_cuda_mul_mat_vec_q(*ctx, &proxy_weight, input, nullptr, dst);
+
+    ggml_cuda_pool_alloc<int32_t> shortlist(ctx->pool(), PF_MTP_OUTPUT_K);
+    hipLaunchKernelGGL(mtp_output_top8, dim3(1), dim3(256), 0, ctx->stream(),
+        static_cast<const float *>(dst->data), PF_MTP_OUTPUT_V, shortlist.get());
+
+    std::vector<float> proxy_logits_host;
+    if (s.mtp_output_k8_validate && s.mtp_output_k8_calls == 0) {
+        proxy_logits_host.resize(PF_MTP_OUTPUT_V);
+        hip_check(hipMemcpyAsync(proxy_logits_host.data(), dst->data,
+                                 proxy_logits_host.size() * sizeof(float),
+                                 hipMemcpyDeviceToHost, ctx->stream()),
+                  "hipMemcpy(mtp proxy logits)");
+    }
+
+    const size_t exact_row_bytes = ggml_row_size(GGML_TYPE_Q8_0_ROCMFPX, PF_MTP_OUTPUT_H);
+    ggml_cuda_pool_alloc<uint8_t> exact_rows(ctx->pool(), size_t(PF_MTP_OUTPUT_K) * exact_row_bytes);
+    hipLaunchKernelGGL(gather_quantized_rows,
+        dim3((size_t(PF_MTP_OUTPUT_K) * exact_row_bytes + 255) / 256), dim3(256), 0, ctx->stream(),
+        static_cast<const uint8_t *>(weight->data), shortlist.get(), exact_rows.get(),
+        exact_row_bytes, PF_MTP_OUTPUT_K);
+
+    ggml_tensor exact_weight = *weight;
+    set_contiguous_2d(exact_weight, GGML_TYPE_Q8_0_ROCMFPX,
+                      PF_MTP_OUTPUT_H, PF_MTP_OUTPUT_K, exact_rows.get());
+    ggml_cuda_pool_alloc<float> exact_logits(ctx->pool(), PF_MTP_OUTPUT_K);
+    ggml_tensor exact_dst = *dst;
+    set_contiguous_2d(exact_dst, GGML_TYPE_F32, PF_MTP_OUTPUT_K, 1, exact_logits.get());
+    ggml_cuda_mul_mat_vec_q(*ctx, &exact_weight, input, nullptr, &exact_dst);
+
+    if (s.mtp_output_k8_validate) {
+        ggml_cuda_pool_alloc<float> reference_logits(ctx->pool(), PF_MTP_OUTPUT_V);
+        ggml_tensor reference_dst = *dst;
+        set_contiguous_2d(reference_dst, GGML_TYPE_F32, PF_MTP_OUTPUT_V, 1, reference_logits.get());
+        ggml_cuda_mul_mat_vec_q(*ctx, weight, input, nullptr, &reference_dst);
+
+        ggml_cuda_pool_alloc<int32_t> reference_top8(ctx->pool(), PF_MTP_OUTPUT_K);
+        hipLaunchKernelGGL(mtp_output_top8, dim3(1), dim3(256), 0, ctx->stream(),
+            reference_logits.get(), PF_MTP_OUTPUT_V, reference_top8.get());
+
+        std::array<int32_t, PF_MTP_OUTPUT_K> shortlist_host {};
+        std::array<float, PF_MTP_OUTPUT_K> exact_logits_host {};
+        int32_t reference_id = -1;
+        hip_check(hipMemcpyAsync(shortlist_host.data(), shortlist.get(), sizeof(shortlist_host),
+                                 hipMemcpyDeviceToHost, ctx->stream()), "hipMemcpy(mtp shortlist)");
+        hip_check(hipMemcpyAsync(exact_logits_host.data(), exact_logits.get(), sizeof(exact_logits_host),
+                                 hipMemcpyDeviceToHost, ctx->stream()), "hipMemcpy(mtp rerank logits)");
+        hip_check(hipMemcpyAsync(&reference_id, reference_top8.get(), sizeof(reference_id),
+                                 hipMemcpyDeviceToHost, ctx->stream()), "hipMemcpy(mtp reference id)");
+        hip_check(hipStreamSynchronize(ctx->stream()), "hipStreamSynchronize(mtp output validation)");
+
+        if (!proxy_logits_host.empty()) {
+            std::array<int32_t, PF_MTP_OUTPUT_K> cpu_top8 {};
+            std::vector<int32_t> order(PF_MTP_OUTPUT_V);
+            for (int32_t i = 0; i < PF_MTP_OUTPUT_V; ++i) {
+                order[i] = i;
+            }
+            std::partial_sort(order.begin(), order.begin() + PF_MTP_OUTPUT_K, order.end(),
+                [&](int32_t lhs, int32_t rhs) {
+                    return proxy_logits_host[lhs] > proxy_logits_host[rhs] ||
+                           (proxy_logits_host[lhs] == proxy_logits_host[rhs] && lhs < rhs);
+                });
+            std::copy_n(order.begin(), PF_MTP_OUTPUT_K, cpu_top8.begin());
+            if (shortlist_host != cpu_top8) {
+                std::fprintf(stderr, "promptforge: MTP output-k8 GPU reducer disagrees with CPU top-8\n");
+                std::abort();
+            }
+            std::fprintf(stderr,
+                "{\"record\":\"promptforge_mtp_output_k8_topk_check\",\"match\":true,\"k\":%d}\n",
+                PF_MTP_OUTPUT_K);
+        }
+
+        int candidate_pos = 0;
+        int reference_pos = -1;
+        for (int i = 0; i < PF_MTP_OUTPUT_K; ++i) {
+            if (exact_logits_host[i] > exact_logits_host[candidate_pos]) {
+                candidate_pos = i;
+            }
+            if (shortlist_host[i] == reference_id) {
+                reference_pos = i;
+            }
+        }
+        const int32_t candidate_id = shortlist_host[candidate_pos];
+        if (reference_pos >= 0) {
+            ++s.mtp_output_k8_validate_hits;
+        }
+        s.mtp_output_k8_validate_matches += candidate_id == reference_id ? 1 : 0;
+        std::fprintf(stderr,
+            "{\"record\":\"promptforge_mtp_output_k8_validate\",\"call\":%llu,"
+            "\"reference_id\":%d,\"candidate_id\":%d,\"contained\":%s,"
+            "\"match\":%s,\"contained_total\":%llu,\"match_total\":%llu}\n",
+            (unsigned long long) (s.mtp_output_k8_calls + 1), reference_id, candidate_id,
+            reference_pos >= 0 ? "true" : "false", candidate_id == reference_id ? "true" : "false",
+            (unsigned long long) s.mtp_output_k8_validate_hits,
+            (unsigned long long) s.mtp_output_k8_validate_matches);
+        std::fflush(stderr);
+    }
+
+    hipLaunchKernelGGL(fill_negative_infinity,
+        dim3((PF_MTP_OUTPUT_V + 255) / 256), dim3(256), 0, ctx->stream(),
+        static_cast<float *>(dst->data), size_t(PF_MTP_OUTPUT_V));
+    hipLaunchKernelGGL(scatter_reranked_logits, dim3(1), dim3(32), 0, ctx->stream(),
+        static_cast<float *>(dst->data), shortlist.get(), exact_logits.get(), PF_MTP_OUTPUT_K);
+
+    ++s.mtp_output_k8_calls;
+    if (s.mtp_output_k8_calls == 1) {
+        std::fprintf(stderr,
+            "{\"record\":\"promptforge_mtp_output_k8_route\",\"calls\":1,"
+            "\"input\":\"mtp_shared_head_norm\",\"rows\":1,\"k\":%d}\n",
+            PF_MTP_OUTPUT_K);
+        std::fflush(stderr);
+    }
     return true;
 }
 
