+    tensor.ne[2] = 1;
+    tensor.ne[3] = 1;
+    tensor.nb[0] = ggml_type_size(type);
+    tensor.nb[1] = ggml_row_size(type, ne0);
+    tensor.nb[2] = tensor.nb[1] * ne1;
+    tensor.nb[3] = tensor.nb[2];
+    tensor.data = data;
+}
