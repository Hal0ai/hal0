[Unit]
Description=hal0 Bifrost LLM gateway (Hermes -> lemond normalization shim)
Documentation=https://github.com/Hal0ai/hal0/tree/main/gateway
After=network-online.target hal0-lemonade.service
Wants=network-online.target
# Gateway is useless without lemond; don't hard-require so it can start and
# retry while lemond warms.
After=hal0-lemonade.service

[Service]
Type=simple
User=hal0
Group=hal0
# Loopback-only: the gateway sits behind hal0-api's surface, never LAN-exposed.
# bifrost-http reads config.json AND writes its sqlite store + logs into
# -app-dir, so it must be writable by the hal0 user (ProtectSystem=strict makes
# /etc read-only). Plugins live in <app-dir>/plugins, referenced by absolute
# path in config.json.
ExecStart=/opt/hal0/bin/bifrost-http -app-dir /var/lib/hal0/bifrost -host 127.0.0.1 -port 8079 -log-style json
Restart=on-failure
RestartSec=3
# Resource guard rails. bifrost-http loads a ~3019-model catalog + plugins into
# memory at startup, so keep headroom above 512M.
MemoryMax=1G
CPUWeight=50
NoNewPrivileges=true
# NOTE: FS sandboxing (ProtectSystem=strict / ProtectHome) is intentionally
# omitted — bifrost-http writes its sqlite store + journal under -app-dir, which
# sits in the hal0 user's home (/var/lib/hal0); strict mode blocked sqlite's
# temp writes with disk-I/O/read-only errors. Revisit with a scoped
# ReadWritePaths + PrivateTmp once the exact write set is characterised.

[Install]
WantedBy=multi-user.target
