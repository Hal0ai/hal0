{
  "_meta": {
    "description": "Any SDXL checkpoint: 25-step DPM++ 2M Karras with a positive and a negative prompt. ckpt_name is patched with the caller's checkpoint.",
    "params": {
      "ckpt_name": "node:4.inputs.ckpt_name",
      "positive_prompt": "node:6.inputs.text",
      "negative_prompt": "node:7.inputs.text",
      "width": "node:5.inputs.width",
      "height": "node:5.inputs.height",
      "batch_size": "node:5.inputs.batch_size",
      "seed": "node:3.inputs.seed",
      "steps": "node:3.inputs.steps",
      "cfg": "node:3.inputs.cfg",
      "filename_prefix": "node:9.inputs.filename_prefix"
    },
    "defaults": {
      "steps": 25,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 25,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "user_checkpoint.safetensors"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a placeholder prompt",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["4", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "hal0",
      "images": ["8", 0]
    }
  }
}
